                        <!-- バインドTextBlock1Opacity追加(2026.9.1yori) -->
                        <TextBlock Text="{x:Static res:Resources.String147}" 
                            Background="Gray" Foreground="White" 
                            Padding="2" FontWeight="Bold" 
                            Width="160" TextAlignment="Left" FontSize="14" Margin="-20,0,0,0"
                            Opacity="{Binding TextBlock1Opacity}"/>
                        <TextBlock Text="{x:Static res:Resources.String148}" 
                            Background="Gray" Foreground="White" 
                            Padding="2" FontWeight="Bold" 
                            Width="160" TextAlignment="Left" Margin="5,0,0,0" FontSize="14"
                            Opacity="{Binding TextBlock1Opacity}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <!-- FontSize="12"→"14"(2026.8.15yori) -->
                        <!-- バインドIsTextBox1Enabled追加(2026.9.1yori) -->
                        <TextBox Text="{Binding InputText28}" Width="80" Margin="60,0,0,0" FontSize="14" IsEnabled="{Binding IsTextBox1Enabled}"/>
                        <TextBox Text="{Binding InputText29}" Width="80" Margin="85,0,0,0" FontSize="14" IsEnabled="{Binding IsTextBox1Enabled}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <!-- FontSize="12"→"14"(2026.8.15yori) -->
