                        <Slider
                            Width="80"
                            Minimum="0" Maximum="1"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="SlideSwitch_ValueChanged"
                            Value="{Binding SlideSwitchValue9}"
