                            Minimum="0" Maximum="65535"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="SlideSwitch_ValueChanged"
                            Value="{Binding SlideSwitchValue10, Mode=TwoWay}"
                            Margin="-20,10,0,5" IsEnabled="{Binding IsSliderEnabled}"/>
