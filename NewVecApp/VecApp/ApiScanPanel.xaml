                            Foreground="White"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0" FontSize="14" Opacity="{Binding TextBlock1Opacity}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <!-- FontSize="10"→"14"(2026.8.15yori) -->
                        <!-- PolyWorksでは点群後処理不可のためグラフ表示しない。連動を無効化(2026.9.1yori) -->
