                                Text="{x:Static res:Resources.String160}"
                                Foreground="White"
                                FontWeight="Bold"
                                VerticalAlignment="Center"
                                Margin="10,5,0,0" FontSize="14" Opacity="0.25"/>
                        <TextBox Text="{Binding InputText34, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="-30,5,0,0" FontSize="14" IsEnabled="False"/>
                        <!-- FontSize="12"→"14"(2026.8.15yori) -->
                        <TextBlock
                                Text="{x:Static res:Resources.String161}"
                                Foreground="White"
                                FontWeight="Bold"
                                VerticalAlignment="Center"
                                Margin="10,5,0,0" FontSize="14" Opacity="0.25"/>
