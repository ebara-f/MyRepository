                <!-- スライダー無効化(2025.11.7yori) -->
                <!-- スライダー有効化(2026.8.6yori) -->
                <!-- Margin="300→230(2026.8.14yori) -->
                <Slider
                    Width="80"
                    Minimum="0" Maximum="1"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="SlideSwitch_ValueChanged"
                    Value="{Binding SlideSwitchValue}"
                    Margin="230,10,0,0"
                    IsEnabled="True" Opacity="1.0"/>
                <!-- 距離マスク未作成のため、TextBlock半透明化(2025.11.7yori) -->
                <!-- TextBlock不透明化(2026.8.6yori) -->
