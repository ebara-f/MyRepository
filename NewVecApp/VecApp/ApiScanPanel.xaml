                    Text="{Binding SlideText}"
                    Foreground="White"
                    FontWeight="Bold"
                    VerticalAlignment="Center"
                    Margin="5,5,0,0"
                    Opacity="1.0"/>
            </StackPanel>
        </DataTemplate>

