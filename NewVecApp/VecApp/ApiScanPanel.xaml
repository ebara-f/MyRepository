                            VerticalAlignment="Center"
                            Margin="-20,0,0,0" FontSize="14" Opacity="0.25"/>
                        <TextBox Text="{Binding InputText36}" Width="50" Margin="10,0,0,0" FontSize="14" IsEnabled="False"/>
                        <TextBlock
                            Text="{x:Static res:Resources.String153}"
                            Foreground="White"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="140,0,0,0" FontSize="14" Opacity="0.25"/>
